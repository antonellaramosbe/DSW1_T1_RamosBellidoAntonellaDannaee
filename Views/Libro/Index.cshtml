@model IEnumerable<DSW1_T1_RamosBellidoAntonellaDannaee.Models.Libro>

@{
    ViewData["Title"] = "Lista de libros";
}

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Mi Biblioteca</h2>
            <p class="text-muted mb-0">Administra tus libros registrados</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Crear" class="btn btn-primary">
                + Registrar libro
            </a>
            <a asp-action="BuscarPorAutor" class="btn btn-outline-secondary">
                Buscar por autor
            </a>
        </div>
    </div>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @ViewBag.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h5 class="fw-semibold mb-3">Libros registrados</h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Id</th>
                            <th>Nombre del libro</th>
                            <th>Autor</th>
                            <th>Editorial</th>
                            <th>ISDN</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td class="fw-semibold">@item.NombreLibro</td>
                                    <td>@item.Autor</td>
                                    <td>@item.NombreEditorial</td>
                                    <td>@item.ISDN</td>
                                    <td class="text-center">
                                        <a asp-action="Editar" asp-route-id="@item.Id"
                                               class="btn btn-warning btn-sm">
                                            Editar
                                        </a>

                                        <form asp-action="Eliminar" asp-route-id="@item.Id"
                                              method="post" class="d-inline">
                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('¿Está seguro de eliminar este libro?');">
                                                Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No hay libros registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
